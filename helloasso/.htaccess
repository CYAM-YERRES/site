# Empêche le téléchargement direct des données sensibles du dossier.
# Les scripts PHP (checkout.php, notify.php) restent accessibles.
<FilesMatch "\.(csv|log)$">
    Require all denied
</FilesMatch>

# Compatibilité anciens serveurs Apache (< 2.4)
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(csv|log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
